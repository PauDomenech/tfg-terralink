#---------------------------------------------------------------------------
# Informació del projecte
#---------------------------------------------------------------------------
PROJECT_NAME           = "TerraLink"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Dispositiu de comunicació per a persones grans basat en Raspberry Pi"
OUTPUT_DIRECTORY       = ./docs
OUTPUT_LANGUAGE        = Catalan

#---------------------------------------------------------------------------
# Fitxers d'entrada
#---------------------------------------------------------------------------
INPUT                  = .
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = NO
EXCLUDE                = ./build ./node_modules

#---------------------------------------------------------------------------
# Extracció de documentació
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

#---------------------------------------------------------------------------
# Formats de sortida
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Diagrama de classes (necessita Graphviz instal·lat)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0

# Diagrama de classes complet
CLASS_DIAGRAMS         = YES
CLASS_GRAPH            = YES

# Relacions entre classes
COLLABORATION_GRAPH    = YES

# Herència
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES

# Profunditat dels diagrames
MAX_DOT_GRAPH_DEPTH    = 3

# Mida dels diagrames
DOT_GRAPH_MAX_NODES    = 100
DOT_IMAGE_FORMAT       = png

# Diagrama de tot el projecte
GRAPHICAL_HIERARCHY    = YES

#---------------------------------------------------------------------------
# Aparença HTML
#---------------------------------------------------------------------------
HTML_OUTPUT            = html
HTML_COLORSTYLE_HUE    = 200
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_TIMESTAMP         = YES
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES

#---------------------------------------------------------------------------
# Comentaris Doxygen als fitxers
#---------------------------------------------------------------------------
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES

#---------------------------------------------------------------------------
# Avisos
#---------------------------------------------------------------------------
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
